<workbook version="2026.2">
  <!-- Generated by payment-growth-analytics on 2026-09-28T13:09:25.644261+00:00 -->
  <datasources />
  <datasource caption="Payment Growth" version="18.1">
    <connection class="federated">
      <relation name="Extract" type="extract" connection="payment_growth.hyper" />
    </connection>
    <column role="measure" type="quantitative" />
    <column caption="SR_pct" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="[success_rate]" />
      <desc>Success Rate % (precomputed in SQL)</desc>
    </column>
    <column caption="AOV" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="IF [authorized_count] &gt; 0 THEN [successful_tpv] / [authorized_count] END" />
      <desc>Average Order Value</desc>
    </column>
    <column caption="Failure_Rate_pct" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="[failure_rate]" />
      <desc>Failure Rate % (precomputed)</desc>
    </column>
    <column caption="SR_Delta_pp" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="[success_rate] - LOOKUP([success_rate], -1)" />
      <desc>SR delta vs previous week (pp)</desc>
    </column>
    <column caption="SR_WoW_pct" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="(ZN([success_rate]) - LOOKUP([success_rate], -1)) / ABS(LOOKUP([success_rate], -1)) * 100" />
      <desc>SR week-over-week % change</desc>
    </column>
    <column caption="Benchmark_Gap_pp" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="[success_rate] - [benchmark_sr]" />
      <desc>Merchant SR minus industry benchmark SR (pp)</desc>
    </column>
    <column caption="Payment_Method_Share_pct" datatype="float" role="measure" type="quantitative">
      <calculation class="tableau.calculation" formula="SUM([tpv]) / TOTAL(SUM([tpv])) * 100" />
      <desc>Payment method share of TPV %</desc>
    </column>
  </datasource>
