# Copy to .env to override defaults. No secrets are required for this project —
# all data is synthetic. This file documents the configuration surface only.

# --- Scale of synthetic generation ---
PGA_N_MERCHANTS=150
PGA_N_WEEKS=10
PGA_TXNS_PER_DAY_PER_MERCHANT=100
PGA_RANDOM_SEED=42

# --- Paths (relative to project root) ---
PGA_DUCKDB_PATH=data/processed/payment_growth.duckdb
PGA_RAW_DIR=data/raw
PGA_GENERATED_DIR=data/generated
PGA_HYPER_PATH=tableau/extracts/payment_growth.hyper

# --- Benchmark thresholds ---
PGA_BENCHMARK_MIN_TXNS=500
PGA_BENCHMARK_MIN_PEERS=5

# --- Opportunity thresholds ---
PGA_OPP_SR_DECLINE_PP=1.5
PGA_OPP_BENCHMARK_GAP_PP=2.0
PGA_OPP_MIN_TXNS=200
PGA_OPP_ERROR_SPIKE_PP=2.0
PGA_OPP_CONCENTRATED_SHARE=0.25

# --- API ---
PGA_API_HOST=127.0.0.1
PGA_API_PORT=8000

# --- Streamlit ---
PGA_STREAMLIT_PORT=8501
